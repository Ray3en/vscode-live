{
  "name": "code-stream-classroom",
  "displayName": "Code Stream Classroom",
  "publisher": "classroom-tools",
  "version": "0.1.0",
  "description": "Stream one editor document to read-only viewers.",
  "engines": { "vscode": "^1.96.0" },
  "main": "./extension.js",
  "extensionKind": ["ui"],
  "contributes": {
    "commands": [
      {"command":"codeStream.start","title":"Code Stream: Start"},
      {"command":"codeStream.join","title":"Code Stream: Join"},
      {"command":"codeStream.copy","title":"Code Stream: Copy Invite"},
      {"command":"codeStream.stop","title":"Code Stream: Stop"}
    ]
  }
}
